{
  "name": "comms-test-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backpine/comms-test-harness.git"
  },
  "bugs": {
    "url": "https://github.com/backpine/comms-test-harness/issues"
  },
  "homepage": "https://github.com/backpine/comms-test-harness#readme",
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "vite build apps/web",
    "check": "bun run typecheck && bun run test && bun run build",
    "db:generate": "alchemy deploy scripts/migrations.run.ts --stage migration-dev --yes",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "plan": "alchemy plan",
    "test": "vitest run",
    "test:live": "bun test test/live/stack.live.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/sql-d1": "4.0.0-beta.102",
    "@effect/sql-pg": "4.0.0-beta.102",
    "alchemy": "2.0.0-beta.65",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.102",
    "vite": "8.1.5",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
